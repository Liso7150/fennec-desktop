{
  "name": "colibri-code",
  "productName": "Colibri Code",
  "version": "1.0.0",
  "description": "Local-first coding agent for Colibri models, with device-tiered MoE inference.",
  "main": "electron/main.js",
  "author": {
    "name": "Colibri Desktop",
    "email": "local@colibri.desktop"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win nsis msi",
    "dist:exe": "npm run build:renderer && electron-builder --win nsis",
    "dist:msi": "npm run build:renderer && electron-builder --win msi",
    "dist:mac": "npm run build:renderer && electron-builder --mac dmg",
    "dist:linux": "npm run build:renderer && electron-builder --linux AppImage deb",
    "dist:all": "npm run build:renderer && electron-builder --win nsis --mac dmg --linux AppImage"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "marked": "^14.1.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "build": {
    "appId": "desktop.colibri.code",
    "productName": "Colibri Code",
    "copyright": "Colibri Desktop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ColibriCode-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Colibri Code"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Colibri Code"
    },
    "mac": {
      "target": [
        {"target": "dmg", "arch": ["x64", "arm64"]}
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "ColibriCode-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {"target": "AppImage", "arch": ["x64"]},
        {"target": "deb", "arch": ["x64"]}
      ],
      "category": "Development",
      "maintainer": "local@colibri.desktop",
      "artifactName": "ColibriCode-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
